---
// Functional line icons only (phone, route, socials, chevron, menu): 1.5 px stroke, currentColor, decorative.
type Name = "phone" | "route" | "instagram" | "facebook" | "chevron" | "menu" | "close";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "route" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.25" /></>}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><path d="M17.2 6.8h.01" /></>}
  {name === "facebook" && <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.5V4.3a19 19 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.4H9v3h2.5V21" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "menu" && <><path d="M4 8h16" /><path d="M4 16h16" /></>}
  {name === "close" && <><path d="m6 6 12 12" /><path d="M18 6 6 18" /></>}
</svg>
